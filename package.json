{
  "name": "orbitos",
  "version": "0.1.2",
  "description": "A rotating sphere of labeled points for React — render any set of skills, links, projects, or facts as an animated 3D-style particle globe on plain HTML5 Canvas.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btbatson/OrbitOS.git"
  },
  "homepage": "https://github.com/btbatson/OrbitOS#readme",
  "bugs": {
    "url": "https://github.com/btbatson/OrbitOS/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://buymeacoffee.com/titusbatson"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "keywords": [
    "react",
    "canvas",
    "globe",
    "3d",
    "particles",
    "visualization",
    "animation"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8",
    "typescript": "^5"
  }
}
